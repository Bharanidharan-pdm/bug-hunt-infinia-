# Copy to .env and fill in (never commit real .env)
PORT=4000
JWT_SECRET=change-me-to-a-long-random-secret-min-32-chars
JWT_EXPIRES_IN=12h

# Production PostgreSQL (see schema.sql). Demo/dev uses file-based JSON store in ./data.
DATABASE_URL=postgres://user:password@localhost:5432/bughunt

# Demo seed admin (clearly labelled DEMO — change in production)
DEMO_ADMIN_EMAIL=admin@bughunt.com
DEMO_ADMIN_PASSWORD=admin123

# Code execution
EXEC_TIMEOUT_MS=5000
EXEC_MAX_OUTPUT=20000
MOCK_NON_PYTHON=true

# Participant restriction: team login email domain (default sasurie.com)
TEAM_EMAIL_DOMAIN=sasurie.com
